PORT=3000

# Segredo usado para assinar os tokens JWT (obrigatório)
JWT_SECRET=troque-por-um-segredo-forte
JWT_EXPIRES_IN=1d

# Banco de dados: sqlite (padrão, zero configuração), mysql ou postgres
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# Usados apenas quando DB_DIALECT=mysql ou postgres
DB_HOST=localhost
DB_PORT=3306
DB_NAME=placar
DB_USER=root
DB_PASS=
